---
import ServicePage from '../../../views/ServicePage.astro';
import { t } from '../../../i18n';

export function getStaticPaths() {
  return t('en').services.items.map((s) => ({ params: { slug: s.slug }, props: { id: s.id } }));
}
const { id } = Astro.props;
---

<ServicePage lang="en" id={id} />
