---
import Icon from './Icon.astro';
import { site } from '../config/site';
import { t, homeAnchor, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  title: string;
  text: string;
}
const { lang, title, text } = Astro.props;
const d = t(lang);
---

<section class="section section--dark cta-band">
  <div class="container cta-band__inner">
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="cta-band__actions">
      <a class="btn btn--primary" href={homeAnchor(lang, 'contact')}>{d.nav.quote}</a>
      <a class="btn btn--ghost" href={`tel:${site.phones[0].tel}`}><Icon name="phone" />{site.phones[0].display}</a>
    </div>
  </div>
</section>

<style>
  .cta-band__inner {
    display: grid;
    gap: var(--space-m);
    align-items: center;
  }
  @media (min-width: 56em) {
    .cta-band__inner {
      grid-template-columns: 1fr auto;
      gap: var(--space-l);
    }
  }
  .cta-band h2 {
    color: #fff;
    font-size: var(--step-3);
  }
  .cta-band p {
    color: #c9d4d8;
    margin: 0;
    max-width: 36rem;
  }
  .cta-band__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
