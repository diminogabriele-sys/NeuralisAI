---
interface Props {
  label: string;
  items: { name: string; path?: string }[];
}
const { label, items } = Astro.props;
---

<nav class="crumbs" aria-label={label}>
  <ol>
    {
      items.map((it, i) => (
        <li>
          {it.path && i < items.length - 1 ? <a href={it.path}>{it.name}</a> : <span aria-current="page">{it.name}</span>}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .crumbs ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    margin: 0 0 var(--space-m);
    padding: 0;
    font-size: var(--step--1);
    color: var(--text-muted);
  }
  .crumbs li + li::before {
    content: '/';
    margin-right: 0.5rem;
    color: var(--cemento);
  }
  .crumbs a {
    color: var(--text-muted);
  }
</style>
