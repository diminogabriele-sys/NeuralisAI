---
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
---

<section class="section" id={d.anchors.about} aria-labelledby="chi-siamo-title">
  <div class="container about">
    <div class="about__text" data-reveal>
      <h2 id="chi-siamo-title">{d.about.title}</h2>
      {d.about.paragraphs.map((p, i) => <p class:list={{ lead: i === 0 }}>{p}</p>)}
      <ul class="checklist about__points">
        {d.about.points.map((p) => <li>{p}</li>)}
      </ul>
    </div>

    <!--
      FOTO PLACEHOLDER: sostituisci questo blocco con la foto reale del team, ad esempio:
      <Image src={teamPhoto} alt={d.about.imageAlt} widths={[480, 800, 1200]} sizes="(min-width: 56em) 40vw, 100vw" />
      dopo aver salvato l'immagine in src/assets/team.jpg e averla importata nel frontmatter.
    -->
    <div class="about__photo" role="img" aria-label={d.about.imageAlt} data-reveal>
      <span>{d.about.imagePlaceholder}</span>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    gap: var(--space-l);
    align-items: center;
  }
  @media (min-width: 56em) {
    .about {
      grid-template-columns: 1.1fr 0.9fr;
      gap: clamp(2rem, 5vw, 5rem);
    }
  }
  .about__text p {
    max-width: 38rem;
  }
  .about__text p:not(.lead) {
    color: var(--text-muted);
  }
  .about__points {
    margin-top: var(--space-m);
    font-weight: 600;
  }
  .about__photo {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 5;
    max-height: 34rem;
    width: 100%;
    border-radius: var(--radius-m);
    background:
      repeating-linear-gradient(-45deg, transparent 0 22px, rgba(255, 255, 255, 0.05) 22px 44px),
      var(--acqua);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-1);
  }
  .about__photo span {
    padding: 0.4rem 0.9rem;
    border: 2px dashed rgba(255, 255, 255, 0.7);
    border-radius: var(--radius-s);
  }
</style>
