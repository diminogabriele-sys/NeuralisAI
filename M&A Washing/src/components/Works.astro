---
import BeforeAfter from './BeforeAfter.astro';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
---

<section class="section section--alt" id={d.anchors.works} aria-labelledby="lavori-title">
  <div class="container">
    <header class="section-head" data-reveal>
      <h2 id="lavori-title">{d.works.title}</h2>
      <p>{d.works.intro}</p>
    </header>
    <div class="works">
      {
        d.works.items.map((w) => (
          <BeforeAfter
            image={w.image}
            caption={w.caption}
            place={w.place}
            label={d.works.sliderLabel}
            beforeLabel={d.hero.before}
            afterLabel={d.hero.after}
          />
        ))
      }
    </div>
  </div>
</section>

<style>
  .works {
    display: grid;
    gap: var(--space-l) clamp(1.5rem, 3vw, 2.5rem);
  }
  @media (min-width: 56em) {
    .works {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
