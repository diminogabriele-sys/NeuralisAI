{
  "name": "TechNote",
  "title": "Protocollo Tech",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Titolo",
      "description": "Titolo dell'approfondimento"
    },
    "excerpt": {
      "type": "string",
      "title": "Estratto",
      "description": "Breve sintesi mostrata nella card"
    },
    "content": {
      "type": "string",
      "format": "textarea",
      "title": "Contenuto",
      "description": "Corpo dell'approfondimento (markdown supportato)"
    },
    "category": {
      "type": "string",
      "title": "Categoria",
      "enum": [
        "Automazione",
        "AI",
        "Web",
        "Tech News"
      ],
      "default": "Automazione"
    },
    "cover_url": {
      "type": "string",
      "format": "image",
      "title": "Copertina",
      "description": "Immagine di copertina opzionale"
    },
    "published_date": {
      "type": "string",
      "format": "date",
      "title": "Data di pubblicazione"
    }
  },
  "required": [
    "title",
    "excerpt",
    "content",
    "category",
    "published_date"
  ]
}