---
import { dictionaries, path } from '../i18n/index.js';
import { site } from '../config/site.js';
interface Props { lang: string }
const { lang } = Astro.props;
const d = dictionaries[lang];
const t = d.contact;
const f = t.form;
const netlify = site.formProvider === 'netlify';
const action = netlify ? path('thanks', lang) : site.formspreeEndpoint;
const socials = Object.entries(site.social).filter(([, url]) => url);
---

<section id="contact" class="section contact" aria-labelledby="contact-title">
  <div class="container">
    <header class="section-head section-head--split">
      <div>
        <p class="kicker reveal" data-n="07">{t.kicker}</p>
        <h2 id="contact-title" class="h-section reveal" set:html={t.title} />
      </div>
      <p class="lead reveal" style="--d:.15s">{t.lead}</p>
    </header>

    <div class="contact-grid">
      <form
        class="form reveal"
        name="preventivo"
        method="POST"
        action={action}
        data-netlify={netlify ? 'true' : undefined}
        netlify-honeypot={netlify ? 'bot-field' : undefined}
        data-form
        data-provider={site.formProvider}
        data-success={f.success}
        data-error={f.error}
        data-sending={f.sending}
        data-required={f.required}
        data-invalid-email={f.invalidEmail}
      >
        {netlify && <input type="hidden" name="form-name" value="preventivo" />}
        <input type="hidden" name="lingua" value={lang} />
        <p class="hp" aria-hidden="true">
          <label>Non compilare <input name={netlify ? 'bot-field' : '_gotcha'} tabindex="-1" autocomplete="off" /></label>
        </p>

        <div class="field">
          <label for="f-name">{f.name} <span aria-hidden="true">*</span></label>
          <input id="f-name" name="nome" type="text" autocomplete="name" required />
        </div>
        <div class="row">
          <div class="field">
            <label for="f-email">{f.email} <span aria-hidden="true">*</span></label>
            <input id="f-email" name="email" type="email" autocomplete="email" required />
          </div>
          <div class="field">
            <label for="f-phone">{f.phone}</label>
            <input id="f-phone" name="telefono" type="tel" autocomplete="tel" />
          </div>
        </div>
        <div class="field">
          <label for="f-bike">{f.bike} <span aria-hidden="true">*</span></label>
          <input id="f-bike" name="moto" type="text" placeholder={f.bikePlaceholder} required />
        </div>
        <div class="row">
          <div class="field">
            <label for="f-service">{f.service}</label>
            <select id="f-service" name="intervento">
              <option value="">{f.select}</option>
              {f.serviceOptions.map((o) => <option>{o}</option>)}
            </select>
          </div>
          <div class="field">
            <label for="f-use">{f.use}</label>
            <select id="f-use" name="utilizzo">
              <option value="">{f.select}</option>
              {f.useOptions.map((o) => <option>{o}</option>)}
            </select>
          </div>
        </div>
        <div class="field">
          <label for="f-msg">{f.message} <span aria-hidden="true">*</span></label>
          <textarea id="f-msg" name="messaggio" rows="5" required></textarea>
        </div>
        <div class="field field--check">
          <input id="f-privacy" name="privacy" type="checkbox" value="accettata" required />
          <label for="f-privacy" set:html={f.privacy.replace('{privacy}', path('privacy', lang))} />
        </div>

        <button class="btn btn--solid submit" type="submit">
          <span data-label>{f.submit}</span>
          <svg class="arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
        </button>
        <p class="form-status" role="status" aria-live="polite" data-status></p>
      </form>

      <aside class="info reveal" style="--d:.15s">
        <div class="info-block">
          <p class="mono info-label">{t.info.email}</p>
          <a class="big" href={`mailto:${site.email}`}>{site.email}</a>
          <p class="info-note">{t.info.emailNote}</p>
        </div>
        {socials.length > 0 && (
          <div class="info-block">
            <p class="mono info-label">{t.info.social}</p>
            <div class="socials">
              {socials.map(([name, url]) => (
                <a href={url} target="_blank" rel="noopener me" aria-label={name[0].toUpperCase() + name.slice(1)}>
                  {name === 'instagram' && <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>}
                  {name === 'facebook' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 8h3V4h-3a4 4 0 0 0-4 4v2H7v4h3v6h4v-6h3l1-4h-4V8z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>}
                  {name === 'youtube' && <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2.5" y="5" width="19" height="14" rx="4" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="m10 9 5 3-5 3z" fill="currentColor"/></svg>}
                  {name === 'tiktok' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5M14 3c.5 3 2.5 4.5 5 4.5" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>}
                  <span class="social-name">{name[0].toUpperCase() + name.slice(1)}</span>
                </a>
              ))}
            </div>
          </div>
        )}
      </aside>
    </div>
  </div>
</section>

<style>
  .contact { background: linear-gradient(180deg, var(--black), var(--surface)); }
  .contact-grid { display: grid; gap: 4rem; }

  .form { display: grid; gap: 1.4rem; }
  .row { display: grid; gap: 1.4rem; }
  .field { display: grid; gap: 0.5rem; }
  .field label { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: #cfc9bd; }
  .field label span { color: var(--gold); }
  input, select, textarea {
    width: 100%;
    min-height: 52px;
    padding: 0.9rem 1rem;
    background: rgba(255, 255, 255, 0.025);
    border: 1px solid rgba(244, 241, 234, 0.18);
    border-radius: var(--radius);
    color: var(--white);
    font-size: 1rem;
    transition: border-color 0.3s, background 0.3s;
  }
  input::placeholder, textarea::placeholder { color: #7c786f; }
  select { appearance: none; background-image: linear-gradient(45deg, transparent 50%, var(--gold) 50%), linear-gradient(135deg, var(--gold) 50%, transparent 50%); background-position: calc(100% - 20px) 50%, calc(100% - 15px) 50%; background-size: 5px 5px; background-repeat: no-repeat; }
  select option { background: var(--surface); color: var(--white); }
  textarea { resize: vertical; min-height: 140px; }
  input:hover, select:hover, textarea:hover { border-color: rgba(201, 164, 92, 0.5); }
  input:focus, select:focus, textarea:focus { outline: none; border-color: var(--gold); background: rgba(201, 164, 92, 0.05); box-shadow: 0 0 0 3px rgba(201, 164, 92, 0.2); }
  [aria-invalid='true'] { border-color: #e0806b; }
  .form :global(.field-error) { color: #f0a08f; font-size: 0.8rem; }

  .field--check { grid-template-columns: auto 1fr; align-items: start; gap: 0.9rem; }
  .field--check input { width: 22px; height: 22px; min-height: 0; padding: 0; margin-top: 0.15rem; accent-color: var(--gold); }
  .field--check label { text-transform: none; letter-spacing: 0; font-weight: 400; font-size: 0.9rem; color: var(--muted); }
  .field--check label :global(a) { color: var(--gold); }
  .field--check :global(.field-error) { grid-column: 2; }

  .submit { justify-self: start; }
  .submit[disabled] { opacity: 0.6; cursor: wait; }
  .form-status { margin: 0; min-height: 1.5em; }
  .form-status.ok { color: var(--gold-light); }
  .form-status.err { color: #f0a08f; }
  .hp { position: absolute; left: -9999px; }

  .info { display: grid; gap: 2rem; align-content: start; }
  .info-block { display: grid; gap: 0.6rem; padding-bottom: 2rem; border-bottom: 1px solid var(--line); }
  .info-label { color: var(--gold); font-size: 0.66rem; margin: 0; }
  .info-note { color: var(--muted); margin: 0; font-size: 0.9rem; }
  .big { font-family: var(--font-display); font-size: clamp(1.6rem, 3.4vw, 2.3rem); text-decoration: none; transition: color 0.3s; overflow-wrap: anywhere; }
  .big:hover { color: var(--gold); }
  .socials { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .socials a { display: inline-flex; align-items: center; gap: 0.6rem; min-height: 46px; padding: 0 1.1rem 0 0.8rem; border: 1px solid var(--line); border-radius: 23px; color: var(--gold); text-decoration: none; font-size: 0.85rem; transition: background 0.3s, color 0.3s; }
  .socials a:hover { background: var(--gold); color: var(--black); }
  .socials svg { width: 20px; }

  @media (min-width: 640px) {
    .row { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 1024px) {
    .contact-grid { grid-template-columns: 1.4fr 1fr; gap: 6rem; }
  }
</style>

<script>
  /* ---------- Modulo contatti: validazione accessibile + invio AJAX (Netlify o Formspree) ---------- */
  const form = document.querySelector<HTMLFormElement>('[data-form]');
  if (form) {
    form.noValidate = true;
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const label = btn.querySelector<HTMLElement>('[data-label]')!;
    const originalLabel = label.textContent;
    const ds = form.dataset;

    const setError = (el: HTMLInputElement, msg: string | null) => {
      const id = `${el.id}-err`;
      let err = document.getElementById(id);
      if (msg) {
        if (!err) {
          err = document.createElement('span');
          err.id = id;
          err.className = 'field-error';
          el.closest('.field')!.append(err);
        }
        err.textContent = msg;
        el.setAttribute('aria-invalid', 'true');
        el.setAttribute('aria-describedby', id);
      } else {
        err?.remove();
        el.removeAttribute('aria-invalid');
        el.removeAttribute('aria-describedby');
      }
    };
    const check = (el: HTMLInputElement) => {
      const ok = el.checkValidity();
      setError(el, ok ? null : el.validity.typeMismatch ? ds.invalidEmail! : ds.required!);
      return ok;
    };
    form.querySelectorAll<HTMLInputElement>('[required]').forEach((el) => {
      el.addEventListener('blur', () => el.value && check(el));
      el.addEventListener('input', () => el.getAttribute('aria-invalid') && check(el));
      el.addEventListener('change', () => el.getAttribute('aria-invalid') && check(el));
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fields = [...form.querySelectorAll<HTMLInputElement>('[required]')];
      const invalid = fields.filter((el) => !check(el));
      if (invalid.length) {
        invalid[0].focus();
        return;
      }
      btn.disabled = true;
      label.textContent = ds.sending!;
      status.className = 'form-status';
      status.textContent = '';
      const data = new FormData(form);
      try {
        // Modalità dimostrativa (anteprima): simula l'invio senza inviare dati
        if (ds.provider === 'demo') {
          await new Promise((r) => setTimeout(r, 700));
          form.reset();
          status.className = 'form-status ok';
          status.textContent = ds.success!;
          return;
        }
        const res =
          ds.provider === 'netlify'
            ? await fetch('/', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: new URLSearchParams(data as unknown as Record<string, string>).toString(),
              })
            : await fetch(form.action, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        status.className = 'form-status ok';
        status.textContent = ds.success!;
      } catch {
        status.className = 'form-status err';
        status.textContent = ds.error!;
      } finally {
        btn.disabled = false;
        label.textContent = originalLabel;
      }
    });
  }

</script>
