---
import { dictionaries } from '../i18n/index.js';
interface Props { lang: string }
const t = dictionaries[Astro.props.lang].process;
const letters = ['A', 'B', 'C'];
---

<section id="process" class="section process" aria-labelledby="process-title">
  <div class="container">
    <header class="section-head section-head--split">
      <div>
        <p class="kicker reveal" data-n="03">{t.kicker}</p>
        <h2 id="process-title" class="h-section reveal" set:html={t.title} />
      </div>
      <p class="lead reveal" style="--d:.15s">{t.lead}</p>
    </header>

    <div class="flow" data-flow>
      <svg class="curves" data-curves aria-hidden="true" focusable="false"></svg>
      <!-- Fasi comuni a tutti i progetti -->
      <ol class="trunk">
        {t.steps.map((s, i) => (
          <li class="step reveal" style={`--d:${i * 0.12}s`}>
            <span class="step-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </div>
          </li>
        ))}
      </ol>

      <!-- Da qui il percorso si divide nei tre servizi -->
      <div class="paths">
        <p class="fork-label mono reveal"><span>{t.branchesLabel}</span></p>
        <ul class="branches">
          {t.branches.map((b, i) => (
            <li class="branch reveal" style={`--d:${0.1 + i * 0.12}s`} tabindex="0" data-branch={i}>
              <span class="branch-link" aria-hidden="true"></span>
              <span class="branch-n mono" aria-hidden="true">04{letters[i]}</span>
              <div class="branch-body">
                <h3>{b.title}</h3>
                <p>{b.text}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .process {
    background:
      radial-gradient(60% 50% at 100% 0%, rgba(201, 164, 92, 0.07), transparent 70%),
      var(--surface);
    border-block: 1px solid var(--line);
  }

  .flow { --rail: 1px solid var(--gold-deep); }

  /* Tronco: fasi in verticale con linea continua */
  .trunk {
    list-style: none;
    margin: 0;
    padding: 0 0 0 2.5rem;
    display: grid;
    gap: 2.25rem;
    border-left: var(--rail);
    margin-left: 0.45rem;
    padding-bottom: 2.25rem;
  }
  .step { position: relative; display: grid; gap: 0.4rem; }
  .step::before {
    content: '';
    position: absolute;
    left: calc(-2.5rem - 5px);
    top: 0.9rem;
    width: 9px;
    height: 9px;
    transform: rotate(45deg);
    background: var(--surface);
    border: 1px solid var(--gold);
  }
  .step-n { font-family: var(--font-display); font-style: italic; font-size: 2.6rem; line-height: 1; color: var(--gold); }
  .step h3 { font-size: 1.75rem; margin-bottom: 0.4rem; }
  .step p { color: var(--muted); margin: 0; max-width: 46ch; }

  .fork-label {
    position: relative;
    margin: 0;
    padding: 0 0 1.75rem 2.5rem;
    margin-left: 0.45rem;
    border-left: var(--rail);
    color: var(--gold);
    font-size: 0.68rem;
  }

  /* Rami: i tre servizi */
  .branches {
    position: relative;
    list-style: none;
    margin: 0 0 0 0.45rem;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .branch {
    position: relative;
    padding: 1.6rem 1.5rem 1.75rem;
    margin-left: 2.5rem;
    background: linear-gradient(160deg, var(--surface-2), var(--black));
    border: 1px solid var(--line);
  }
  /* raccordo dal binario alla card (mobile) */
  .branch::before {
    content: '';
    position: absolute;
    left: calc(-2.5rem - 1px);
    top: 2rem;
    width: 2.5rem;
    border-top: var(--rail);
  }
  .branch:not(:last-child)::after {
    content: '';
    position: absolute;
    left: calc(-2.5rem - 1px);
    top: -1rem;
    bottom: -1rem;
    border-left: var(--rail);
  }
  .branch:first-child::after { top: -1px; }
  .branch:last-child { margin-bottom: 0; }
  .branch:last-child::after {
    content: '';
    position: absolute;
    left: calc(-2.5rem - 1px);
    top: -1rem;
    height: 3rem;
    border-left: var(--rail);
  }
  .branch-n { display: inline-block; color: var(--black); background: var(--gold); padding: 0.2rem 0.5rem; font-size: 0.66rem; margin-bottom: 1rem; }
  .branch h3 { font-size: 1.6rem; margin-bottom: 0.6rem; }
  .branch p { color: var(--muted); margin: 0; }

  .branch-link { display: none; }

  /* ---------- Linee curve dei rami (disegnate via JS in SVG) ---------- */
  .flow { position: relative; }
  .curves { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; z-index: 0; }
  .trunk, .paths { position: relative; z-index: 1; }
  .curves :global(path) {
    fill: none;
    stroke: var(--gold-deep);
    stroke-width: 1;
    transition: stroke 0.4s var(--ease), stroke-width 0.4s var(--ease), filter 0.4s var(--ease), opacity 0.4s;
  }
  .curves :global(path.flowline) { stroke: var(--gold-light); stroke-width: 2; stroke-dasharray: 6 14; opacity: 0; }
  .curves :global(.is-lit path.base) { stroke: var(--gold); stroke-width: 2; filter: drop-shadow(0 0 6px rgba(230, 199, 127, 0.8)); }
  .curves :global(.is-lit path.flowline) { opacity: 1; animation: flowdash 1.2s linear infinite; }
  .curves :global(.is-dim path.base) { opacity: 0.45; }
  @keyframes flowdash { to { stroke-dashoffset: -40; } }
  @media (prefers-reduced-motion: reduce) { .curves :global(.is-lit path.flowline) { animation: none; } }

  /* con le curve attive non servono i raccordi ad angolo retto */
  .flow.has-curves .branch::before,
  .flow.has-curves .branch::after,
  .flow.has-curves .branch-link,
  .flow.has-curves .branches::before { display: none !important; }

  .branch { cursor: pointer; transition: opacity 1.1s var(--ease), transform 1.1s var(--ease), border-color 0.4s var(--ease), box-shadow 0.4s var(--ease); transition-delay: var(--d, 0s), var(--d, 0s), 0s, 0s; }
  .branch:focus-visible { outline: 2px solid var(--gold-light); outline-offset: 3px; }
  .branch.is-lit { border-color: var(--gold); box-shadow: 0 0 0 1px rgba(201, 164, 92, 0.25), 0 12px 40px rgba(201, 164, 92, 0.12); }
  .branch.is-lit .branch-n { box-shadow: 0 0 14px rgba(230, 199, 127, 0.6); }

  /* Desktop: schema orizzontale. Le tre fasi da sinistra a destra, poi la linea
     si divide nei tre rami, uno per riga, sulla destra. */
  @media (min-width: 1100px) {
    .flow {
      --ly: 2.4rem; /* altezza della linea principale */
      --rail-gap: 6rem; /* spazio orizzontale in cui si aprono le curve dei rami */
      display: grid;
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      align-items: start;
    }

    .trunk {
      position: relative;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2rem;
      margin: 0;
      padding: 0 2.5rem 0 0;
      border-left: 0;
    }
    /* linea che attraversa le tre fasi e prosegue fino ai rami */
    .trunk::before {
      content: '';
      position: absolute;
      top: var(--ly);
      left: 0;
      right: 0;
      border-top: var(--rail);
    }
    .step { padding-top: calc(var(--ly) + 1.6rem); }
    .step::before { left: 0; top: calc(var(--ly) - 5px); }
    .step-n { position: absolute; top: 0; left: 1.5rem; font-size: 2.2rem; }
    .step h3 { font-size: 1.6rem; }

    .paths { position: relative; }
    /* su PC la biforcazione disegnata sostituisce la scritta (resta per i lettori di schermo) */
    .fork-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      margin: 0;
      padding: 0;
      border: 0;
    }

    .branches { margin: 0; padding: 0 0 0 var(--rail-gap); gap: 1rem; }
    .branch {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 0 1.25rem;
      align-items: start;
      margin-left: 0;
      padding: 1.4rem 1.5rem;
    }
    .branch-n { margin: 0.35rem 0 0; }
    .branch h3 { font-size: 1.5rem; margin-bottom: 0.35rem; }
    /* collegamento orizzontale dalla linea verticale alla card */
    .branch::before {
      left: calc(-1 * var(--rail-gap) - 1px);
      top: calc(var(--ly) - 1px);
      width: var(--rail-gap);
    }
    /* linea verticale: dal collegamento di questa card fino al fondo dello spazio sotto */
    .branch:not(:last-child)::after,
    .branch:first-child::after {
      left: calc(-1 * var(--rail-gap) - 1px);
      top: calc(var(--ly) - 1px);
      bottom: -1rem;
      height: auto;
    }
    .branch:last-child::after { display: none; }
    /* tratto verticale dall'alto della card fino al suo collegamento */
    .branch:not(:first-child) .branch-link {
      display: block;
      position: absolute;
      left: calc(-1 * var(--rail-gap) - 1px);
      top: -1px;
      height: var(--ly);
      border-left: var(--rail);
    }
    /* il primo ramo parte esattamente dalla linea principale: tratto che le unisce */
    .branches::before {
      content: '';
      position: absolute;
      top: calc(var(--ly) - 5px);
      left: -5px;
      width: 9px;
      height: 9px;
      transform: rotate(45deg);
      background: var(--gold);
    }
  }
</style>

<script>
  // Disegna i rami come curve dalla biforcazione a ciascuna card e illumina quello attivo
  const flow = document.querySelector<HTMLElement>('[data-flow]');
  const svg = flow?.querySelector<SVGSVGElement>('[data-curves]');
  if (flow && svg) {
    const NS = 'http://www.w3.org/2000/svg';
    const branches = [...flow.querySelectorAll<HTMLElement>('[data-branch]')];
    const trunk = flow.querySelector<HTMLElement>('.trunk')!;
    const list = flow.querySelector<HTMLElement>('.branches')!;
    const desktop = window.matchMedia('(min-width: 1100px)');
    let selected = -1;
    let hovered = -1;
    const groups: SVGGElement[] = [];

    const draw = () => {
      const box = flow.getBoundingClientRect();
      const ly = parseFloat(getComputedStyle(flow).getPropertyValue('--ly')) * parseFloat(getComputedStyle(document.documentElement).fontSize) || 38;
      let sx: number, sy: number;
      if (desktop.matches) {
        // dal termine della linea delle fasi
        sx = trunk.getBoundingClientRect().right - box.left;
        sy = trunk.getBoundingClientRect().top - box.top + ly;
      } else {
        // dal binario verticale, all'inizio dei rami
        sx = trunk.getBoundingClientRect().left - box.left;
        sy = list.getBoundingClientRect().top - box.top - 4;
      }
      svg.setAttribute('viewBox', `0 0 ${box.width} ${box.height}`);
      svg.replaceChildren();
      groups.length = 0;
      branches.forEach((b) => {
        const r = b.getBoundingClientRect();
        const ex = r.left - box.left;
        const ey = r.top - box.top + (desktop.matches ? ly : 32);
        let d: string;
        if (desktop.matches) {
          const dx = (ex - sx) * 0.55;
          d = `M${sx},${sy} C${sx + dx},${sy} ${ex - dx},${ey} ${ex},${ey}`;
        } else {
          const k = Math.min(ey - sy, ex - sx) * 0.9;
          d = `M${sx},${sy} L${sx},${Math.max(sy, ey - k)} C${sx},${ey} ${sx},${ey} ${sx + k},${ey} L${ex},${ey}`;
        }
        const g = document.createElementNS(NS, 'g');
        for (const cls of ['base', 'flowline']) {
          const path = document.createElementNS(NS, 'path');
          path.setAttribute('d', d);
          path.setAttribute('class', cls);
          g.append(path);
        }
        // punto d'arrivo sulla card
        const dot = document.createElementNS(NS, 'circle');
        dot.setAttribute('cx', String(ex));
        dot.setAttribute('cy', String(ey));
        dot.setAttribute('r', '3');
        dot.setAttribute('fill', 'var(--gold)');
        g.append(dot);
        svg.append(g);
        groups.push(g);
      });
      // nodo della biforcazione
      const node = document.createElementNS(NS, 'rect');
      node.setAttribute('x', String(sx - 4.5));
      node.setAttribute('y', String(sy - 4.5));
      node.setAttribute('width', '9');
      node.setAttribute('height', '9');
      node.setAttribute('fill', 'var(--gold)');
      node.setAttribute('transform', `rotate(45 ${sx} ${sy})`);
      svg.append(node);
      paint();
    };

    const paint = () => {
      const active = hovered >= 0 ? hovered : selected;
      groups.forEach((g, i) => {
        g.classList.toggle('is-lit', i === active);
        g.classList.toggle('is-dim', active >= 0 && i !== active);
      });
      branches.forEach((b, i) => {
        b.classList.toggle('is-lit', i === active);
        b.setAttribute('aria-pressed', String(i === selected));
      });
    };

    branches.forEach((b, i) => {
      b.setAttribute('role', 'button');
      b.addEventListener('mouseenter', () => { hovered = i; paint(); });
      b.addEventListener('mouseleave', () => { hovered = -1; paint(); });
      b.addEventListener('focus', () => { hovered = i; paint(); });
      b.addEventListener('blur', () => { hovered = -1; paint(); });
      const toggle = () => { selected = selected === i ? -1 : i; paint(); };
      b.addEventListener('click', toggle);
      b.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle(); }
      });
    });

    flow.classList.add('has-curves');
    draw();
    new ResizeObserver(draw).observe(flow);
    desktop.addEventListener('change', draw);
    // le card entrano con un'animazione: ridisegna quando finisce
    branches.forEach((b) => b.addEventListener('transitionend', (e) => { if ((e as TransitionEvent).propertyName === 'transform') draw(); }));
    document.fonts?.ready.then(draw);
  }
</script>
