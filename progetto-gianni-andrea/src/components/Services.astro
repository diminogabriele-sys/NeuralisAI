---
import { Picture } from 'astro:assets';
import { dictionaries } from '../i18n/index.js';
import { images } from '../lib/images.js';
interface Props { lang: string }
const t = dictionaries[Astro.props.lang].services;
---

<section id="services" class="section services" aria-labelledby="services-title">
  <div class="container">
    <header class="section-head section-head--split">
      <div>
        <p class="kicker reveal" data-n="01">{t.kicker}</p>
        <h2 id="services-title" class="h-section reveal" set:html={t.title} />
      </div>
      <p class="lead reveal" style="--d:.15s">{t.lead}</p>
    </header>

    <ul class="cards">
      {t.items.map((s, i) => (
        <li class="card reveal" style={`--d:${i * 0.12}s`} data-tilt>
          <div class="card-media">
            <Picture
              src={images[s.image]}
              alt={s.alt}
              formats={['avif', 'webp']}
              widths={[480, 800, 1200]}
              sizes="(min-width: 960px) 33vw, (min-width: 640px) 50vw, 100vw"
              loading="lazy"
              decoding="async"
            />
            <span class="card-index mono" aria-hidden="true">0{i + 1}</span>
          </div>
          <div class="card-body">
            <h3>{s.title}</h3>
            <p>{s.text}</p>
            <p class="card-spec mono">{s.spec}</p>
          </div>
          <span class="card-glare" aria-hidden="true"></span>
        </li>
      ))}
    </ul>

    <div class="materials">
      <h3 class="materials-title mono reveal">{t.materialsTitle}</h3>
      <ul class="materials-list">
        {t.materials.map((m, i) => (
          <li class="reveal" style={`--d:${i * 0.06}s`}>
            <span class="m-name">{m.name}</span>
            <span class="m-note mono">{m.note}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
    perspective: 1200px;
  }
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: linear-gradient(160deg, var(--surface-2), var(--surface) 60%);
    border: 1px solid var(--line);
    transform-style: preserve-3d;
    transition: transform 0.6s var(--ease), border-color 0.4s, opacity 1.1s var(--ease);
    will-change: transform;
  }
  .card:hover { border-color: rgba(201, 164, 92, 0.55); }
  .card-media { position: relative; overflow: hidden; aspect-ratio: 4 / 3; }
  .card-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.04);
    transition: transform 1.2s var(--ease);
  }
  .card:hover .card-media :global(img) { transform: scale(1.1); }
  .card-index {
    position: absolute;
    top: 1rem;
    left: 1rem;
    padding: 0.35rem 0.6rem;
    background: rgba(10, 10, 11, 0.7);
    color: var(--gold);
    font-size: 0.7rem;
  }
  .card-body { padding: 1.75rem 1.5rem 2rem; transform: translateZ(30px); }
  .card-body h3 { font-size: clamp(1.8rem, 3vw, 2.3rem); margin-bottom: 0.9rem; }
  .card-body p { color: var(--muted); }
  .card-spec { margin: 1.5rem 0 0; padding-top: 1rem; border-top: 1px solid var(--line); color: var(--gold) !important; font-size: 0.68rem; }
  .card-glare {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(400px circle at var(--gx, 50%) var(--gy, 0%), rgba(230, 199, 127, 0.12), transparent 50%);
    opacity: 0;
    transition: opacity 0.4s;
  }
  .card:hover .card-glare { opacity: 1; }

  .materials { margin-top: clamp(4rem, 9vw, 7rem); display: grid; gap: 2rem; }
  .materials-title { color: var(--gold); margin: 0; font-weight: 400; }
  .materials-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    border-top: 1px solid var(--line);
  }
  .materials-list li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 1.2rem 0;
    border-bottom: 1px solid var(--line);
    transition: padding 0.5s var(--ease), background 0.5s;
  }
  .materials-list li:hover { padding-inline: 1rem; background: rgba(201, 164, 92, 0.05); }
  .m-name { font-family: var(--font-display); font-size: clamp(1.4rem, 2.6vw, 1.9rem); }
  .m-note { color: var(--muted); font-size: 0.64rem; text-align: right; }

  @media (min-width: 640px) {
    .cards { grid-template-columns: repeat(2, 1fr); }
    .materials-list { grid-template-columns: repeat(2, 1fr); column-gap: 3rem; }
  }
  @media (min-width: 960px) {
    .cards { grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
    .cards .card:nth-child(2) { margin-top: 4rem; }
    .materials { grid-template-columns: 1fr 3fr; }
  }
</style>

<script>
  // Effetto tilt 3D sulle card (solo dispositivi con mouse e senza reduced motion)
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (fine && !reduced) {
    document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((card) => {
      card.addEventListener('pointermove', (e) => {
        const r = card.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width;
        const y = (e.clientY - r.top) / r.height;
        card.style.transform = `rotateY(${(x - 0.5) * 8}deg) rotateX(${(0.5 - y) * 8}deg)`;
        card.style.setProperty('--gx', `${x * 100}%`);
        card.style.setProperty('--gy', `${y * 100}%`);
      });
      card.addEventListener('pointerleave', () => (card.style.transform = ''));
    });
  }
</script>
