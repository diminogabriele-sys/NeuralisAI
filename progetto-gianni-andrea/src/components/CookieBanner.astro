---
import { dictionaries, path } from '../i18n/index.js';
interface Props { lang: string }
const { lang } = Astro.props;
const t = dictionaries[lang].cookie;
---

<div class="cookie" role="dialog" aria-modal="false" aria-labelledby="cookie-title" aria-describedby="cookie-text" data-cookie hidden>
  <p id="cookie-title" class="cookie-title">{t.title}</p>
  <p id="cookie-text" class="cookie-text">
    {t.text} <a href={path('privacy', lang)}>{t.more}</a>
  </p>
  <div class="cookie-actions">
    <button type="button" class="btn btn--ghost" data-cookie-choice="necessary">{t.reject}</button>
    <button type="button" class="btn btn--solid" data-cookie-choice="all">{t.accept}</button>
  </div>
</div>

<style>
  .cookie {
    position: fixed;
    left: 1rem;
    right: 1rem;
    bottom: 1rem;
    z-index: 200;
    max-width: 460px;
    padding: 1.5rem;
    background: rgba(18, 18, 20, 0.96);
    backdrop-filter: blur(12px);
    border: 1px solid var(--line);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
    animation: cookieIn 0.8s var(--ease) both;
  }
  .cookie[hidden] { display: none; }
  @keyframes cookieIn { from { opacity: 0; transform: translateY(20px); } }
  @media (max-width: 639px) {
    .cookie { padding: 1.1rem; left: 0.75rem; right: 0.75rem; bottom: 0.75rem; }
    .cookie-text { font-size: 0.8rem; line-height: 1.5; margin-bottom: 0.9rem; }
    .cookie-title { font-size: 1.25rem !important; }
  }
  .cookie-title { font-family: var(--font-display); font-size: 1.5rem; color: var(--gold); margin: 0 0 0.5rem; }
  .cookie-text { font-size: 0.88rem; color: var(--muted); margin: 0 0 1.25rem; }
  .cookie-text a { color: var(--white); }
  .cookie-actions { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .cookie-actions .btn { flex: 1 1 auto; --pad: 0.8rem 1.1rem; font-size: 0.7rem; }
  @media (min-width: 640px) { .cookie { left: 1.5rem; bottom: 1.5rem; right: auto; } }
</style>

<script>
  const KEY = 'xxx-consent';
  const banner = document.querySelector<HTMLElement>('[data-cookie]')!;
  const get = () => { try { return localStorage.getItem(KEY); } catch { return null; } };
  const show = () => {
    banner.hidden = false;
    banner.querySelector<HTMLElement>('[data-cookie-choice="all"]')?.focus({ preventScroll: true });
  };
  if (!get()) banner.hidden = false;

  banner.querySelectorAll<HTMLButtonElement>('[data-cookie-choice]').forEach((b) =>
    b.addEventListener('click', () => {
      try { localStorage.setItem(KEY, b.dataset.cookieChoice!); } catch {}
      banner.hidden = true;
      window.dispatchEvent(new Event('consent-change'));
    })
  );
  document.querySelectorAll('[data-cookie-open]').forEach((b) => b.addEventListener('click', show));
  window.addEventListener('consent-change', () => { if (get()) banner.hidden = true; });
</script>
