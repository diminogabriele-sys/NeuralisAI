---
/**
 * Logo Orion. Il file viene da models/logo-orion-originale.jpg, convertito con
 * `node scripts/make-logo.mjs` in src/assets/brand/logo-orion.png (sfondo trasparente).
 * Il nome accessibile è sul link che contiene il logo, quindi qui alt è vuoto.
 */
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo-orion.png';
interface Props { class?: string; height?: number }
const { class: cls = '', height = 52 } = Astro.props;
---
<Image
  src={logo}
  alt=""
  class={`logo ${cls}`}
  height={height}
  densities={[1, 2]}
  format="webp"
  loading="eager"
  decoding="async"
  style={`height:${height}px;width:auto`}
/>
<style>
  .logo { display: block; width: auto; max-width: none; }
</style>
