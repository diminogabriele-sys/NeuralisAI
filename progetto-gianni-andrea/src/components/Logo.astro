---
/**
 * LOGO SEGNAPOSTO — sostituisci l'SVG qui sotto con il logo definitivo
 * (mantieni viewBox e aria-hidden; il nome accessibile è sul link che lo contiene).
 */
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<svg class={`logo ${cls}`} viewBox="0 0 132 36" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="logo-g" x1="0" x2="1" y1="0" y2="1">
      <stop offset="0" stop-color="#8A6A2F" />
      <stop offset=".5" stop-color="#E6C77F" />
      <stop offset="1" stop-color="#C9A45C" />
    </linearGradient>
  </defs>
  <path d="M2 30 L14 6 L26 30" fill="none" stroke="url(#logo-g)" stroke-width="1.5" />
  <path d="M7 21 H21" stroke="url(#logo-g)" stroke-width="1.5" />
  <text x="36" y="27" fill="url(#logo-g)" font-family="Cormorant Garamond, serif" font-size="26" font-weight="500" letter-spacing="7">XXX</text>
</svg>
<style>
  .logo { height: 32px; width: auto; }
</style>
