---
/**
 * LOGO SEGNAPOSTO — sostituisci l'SVG qui sotto con il logo definitivo
 * (mantieni viewBox e aria-hidden; il nome accessibile è sul link che lo contiene).
 */
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<svg class={`logo ${cls}`} viewBox="0 0 218 40" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="logo-g" x1="0" x2="1" y1="0" y2="1">
      <stop offset="0" stop-color="#8A6A2F" />
      <stop offset=".5" stop-color="#E6C77F" />
      <stop offset="1" stop-color="#C9A45C" />
    </linearGradient>
  </defs>
  <path d="M2 34 L16 6 L30 34" fill="none" stroke="url(#logo-g)" stroke-width="1.5" />
  <path d="M8 23 H24" stroke="url(#logo-g)" stroke-width="1.5" />
  <text x="40" y="19" fill="url(#logo-g)" font-family="Cormorant Garamond, serif" font-size="17" font-weight="500" letter-spacing="3.2">BEYOND THE</text>
  <text x="40" y="36" fill="url(#logo-g)" font-family="Cormorant Garamond, serif" font-size="17" font-weight="500" letter-spacing="5.6">FACTORY</text>
</svg>
<style>
  .logo { height: 44px; width: auto; }
</style>
