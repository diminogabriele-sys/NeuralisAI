---
import { dictionaries } from '../i18n/index.js';
import { site } from '../config/site.js';
interface Props { lang: string }
const t = dictionaries[Astro.props.lang].whatsapp;
const href = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(t.message)}`;
---

<a class="wa" href={href} target="_blank" rel="noopener" aria-label={t.label}>
  <svg viewBox="0 0 32 32" aria-hidden="true"><path fill="currentColor" d="M16 3C8.8 3 3 8.7 3 15.8c0 2.5.7 4.9 2 7L3 29l6.4-2a13.2 13.2 0 0 0 6.6 1.7c7.2 0 13-5.7 13-12.9S23.2 3 16 3zm0 23.4c-2.1 0-4.1-.6-5.9-1.7l-.4-.2-3.8 1.2 1.2-3.7-.3-.4a10.5 10.5 0 0 1-1.7-5.7C5.1 10 10 5.3 16 5.3S26.9 10 26.9 15.8 22 26.4 16 26.4zm6-7.8c-.3-.2-1.9-1-2.2-1s-.5-.2-.7.2l-1 1.2c-.2.2-.4.2-.7.1-.3-.2-1.4-.5-2.6-1.6-1-.9-1.6-1.9-1.8-2.2-.2-.3 0-.5.1-.7l.5-.6.3-.5c.1-.2 0-.4 0-.6l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.2 1.1-1.2 2.8s1.2 3.2 1.4 3.5c.2.2 2.4 3.6 5.8 5 .8.4 1.4.6 1.9.7.8.3 1.5.2 2.1.1.6-.1 1.9-.8 2.2-1.5.3-.7.3-1.4.2-1.5-.1-.2-.3-.3-.6-.4z"/></svg>
  <span class="wa-label">{t.label}</span>
</a>

<style>
  .wa {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 90;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    height: 56px;
    padding: 0 16px;
    border-radius: 28px;
    background: var(--black);
    border: 1px solid var(--gold);
    color: var(--gold);
    text-decoration: none;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    transition: background 0.4s, color 0.4s, transform 0.4s var(--ease);
  }
  .wa svg { width: 24px; flex: 0 0 24px; }
  .wa-label { max-width: 0; overflow: hidden; white-space: nowrap; font-size: 0.8rem; font-weight: 600; transition: max-width 0.5s var(--ease); }
  @media (max-width: 639px) { .wa { height: 50px; padding: 0 13px; } }
  .wa:hover, .wa:focus-visible { background: var(--gold); color: var(--black); transform: translateY(-2px); }
  .wa:hover .wa-label, .wa:focus-visible .wa-label { max-width: 260px; }
</style>
